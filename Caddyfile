# Origin for the cookbook.bunsenbrenner.org demo — same shape as flappy-demo/help-site: Caddy
# terminates TLS, so it needs NO inbound :80/:443 of its own. The Browser-Plane agent forwards
# the raw TLS here; TLS terminates at this origin, keeping the edge/plane payload-blind.
#
# #219: the cert is issued CORE-side (scripts/authorize-pipeline.sh, deSEC DNS-01 with the
# operator's zone-wide token) and mounted in as static files — this Caddyfile only ever reads
# fullchain.pem/privkey.pem, never holds a DNS credential of its own.

cookbook.bunsenbrenner.org {
	# #201: the studio POSTs its {prompt, image?} here; the cookbook crew bridge runs
	# safety→structure→presentation→review over the tunnel and streams back the recipe. A more
	# specific matcher than the file_server below, so Caddy routes it first.
	reverse_proxy /cookbook/build cookbook-crew-bridge:8789
	root * /srv
	file_server
	encode gzip
	tls /certs/fullchain.pem /certs/privkey.pem
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
	}
}
